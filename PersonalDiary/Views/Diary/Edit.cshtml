@model DiaryEntryInputModel
@{
    ViewData["Title"] = "Edit Entry";
}

<h1>Edit diary entry</h1>
<p class="text-muted">You can update this entry up to five times.</p>

<form asp-action="Edit" method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="EntryDate" type="hidden" />
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <partial name="_RichTextEditor" model="Model.Notes" />
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-date="@Model.EntryDate.ToString("yyyy-MM-dd")" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
