@model DiaryEntry
@{
    ViewData["Title"] = Model.EntryDate.ToString("D");
    var canEdit = Model.EditCount < 5;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>@Model.EntryDate.ToString("D")</h1>
        <p class="text-muted">Updated @Model.UpdatedUtc.ToLocalTime().ToString("g")</p>
    </div>
    @if (canEdit)
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-date="@Model.EntryDate.ToString("yyyy-MM-dd")">Edit entry</a>
    }
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}

<div class="card">
    <div class="card-body diary-note">@Html.Raw(PersonalDiary.Services.RichTextSanitizer.Sanitize(Model.Notes))</div>
    <div class="card-footer text-muted">@Model.EditCount of 5 edits used</div>
</div>

<a asp-action="Index" class="btn btn-link px-0 mt-3">Back to my diary</a>
