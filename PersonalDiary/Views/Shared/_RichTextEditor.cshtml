@model string

<div class="rich-text-editor" data-rich-text-editor>
    <div class="editor-ribbon" role="toolbar" aria-label="Text formatting options">
        <div class="editor-tool-group">
            <button type="button" class="editor-tool" data-command="undo" title="Undo" aria-label="Undo">↶</button>
            <button type="button" class="editor-tool" data-command="redo" title="Redo" aria-label="Redo">↷</button>
        </div>
        <div class="editor-tool-group">
            <select class="editor-select" data-command="formatBlock" title="Text style" aria-label="Text style">
                <option value="p">Normal</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
                <option value="blockquote">Quote</option>
            </select>
            <select class="editor-select editor-font-select" data-command="fontName" title="Font" aria-label="Font">
                <option value="Arial">Arial</option>
                <option value="Georgia">Georgia</option>
                <option value="Tahoma">Tahoma</option>
                <option value="Times New Roman">Times New Roman</option>
                <option value="Verdana">Verdana</option>
            </select>
            <select class="editor-select" data-command="fontSize" title="Font size" aria-label="Font size">
                <option value="3">Size</option>
                <option value="1">Small</option>
                <option value="3">Normal</option>
                <option value="5">Large</option>
                <option value="7">Huge</option>
            </select>
        </div>
        <div class="editor-tool-group">
            <button type="button" class="editor-tool editor-tool-bold" data-command="bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
            <button type="button" class="editor-tool editor-tool-italic" data-command="italic" title="Italic" aria-label="Italic"><em>I</em></button>
            <button type="button" class="editor-tool editor-tool-underline" data-command="underline" title="Underline" aria-label="Underline"><u>U</u></button>
            <button type="button" class="editor-tool" data-command="strikeThrough" title="Strikethrough" aria-label="Strikethrough"><s>S</s></button>
        </div>
        <div class="editor-tool-group">
            <label class="editor-color" title="Text color" aria-label="Text color">A <input type="color" data-command="foreColor" value="#212529" /></label>
            <label class="editor-color editor-color-highlight" title="Highlight color" aria-label="Highlight color">▰ <input type="color" data-command="hiliteColor" value="#fff3cd" /></label>
        </div>
        <div class="editor-tool-group">
            <button type="button" class="editor-tool" data-command="justifyLeft" title="Align left" aria-label="Align left">☰</button>
            <button type="button" class="editor-tool" data-command="justifyCenter" title="Align center" aria-label="Align center">≡</button>
            <button type="button" class="editor-tool" data-command="justifyRight" title="Align right" aria-label="Align right">☷</button>
            <button type="button" class="editor-tool" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list">•☰</button>
            <button type="button" class="editor-tool" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list">1☰</button>
        </div>
        <div class="editor-tool-group">
            <button type="button" class="editor-tool" data-command="createLink" title="Insert link" aria-label="Insert link">🔗</button>
            <button type="button" class="editor-tool" data-command="removeFormat" title="Clear formatting" aria-label="Clear formatting">Tx</button>
        </div>
    </div>
    <div class="editor-surface" contenteditable="true" role="textbox" aria-multiline="true" data-editor-surface></div>
    <input type="hidden" name="Notes" value="@Model" data-editor-value />
</div>
